# Copy this file to .env and set the path. .env is git-ignored; songs are never committed.
#
# MICROGROOVE_SONG is the audio file used on this machine for real-song checks and viewings.
# The program itself never reads this file: it takes the path on the command line.
MICROGROOVE_SONG="/absolute/path/to/song.flac"

# MICROGROOVE_SONG_WAV is the same master in another container (a WAV where the song is
# a FLAC). It is used only by the check that both give identical analysis numbers.
MICROGROOVE_SONG_WAV="/absolute/path/to/song.wav"
