# Rust build output
target/
**/*.rs.bk

# Cargo.lock stays tracked: this is an application.

# Songs are private inputs and never repository content.
*.flac
*.wav
*.mp3
*.ogg
*.opus
*.m4a
*.aac
*.aiff

# Derived, disposable output. The program writes stills/ and captures/ under whatever
# directory it is run from, so those two are ignored at any depth.
/cache/
stills/
captures/
/logs/

# Local configuration and credentials
.env
.env.*
!.env.example
.private-terms
*.local.toml

# Editor and OS files
.DS_Store
*~
*.swp
*.swo
